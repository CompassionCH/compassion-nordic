<odoo>
    <record id="account_reports.general_ledger_report" model="account.report">
        <field name="filter_aml_ir_filters" eval="True" />
    </record>
    <record model="ir.filters" id="on_balance_lines_filter">
        <field name="name">On-Balance</field>
        <field name="model_id">account.move.line</field>
        <field name="domain">[('account_id.is_off_balance', '=', False)]</field>
        <field name="context">{}</field>
        <field name="user_id" eval="False" />
    </record>
</odoo>
