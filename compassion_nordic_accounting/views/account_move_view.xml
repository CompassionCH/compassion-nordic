<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">add.mandate.on.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_payment_partner.view_move_form" />
        <field name="arch" type="xml">
            <field name="mandate_id" position="attributes">
                <attribute
          name="domain"
        >[('partner_id', '=', commercial_partner_id), ('state', '=', 'valid')]</attribute>
                <attribute
          name="readonly"
        >state not in ['draft', 'posted']</attribute>
                <attribute
          name="required"
        >mandate_required == True and move_type in ('out_invoice', 'out_refund')</attribute>
                <attribute
          name="invisible"
        >not mandate_required or move_type not in ('out_invoice', 'out_refund')</attribute>
            </field>
            <field name="payment_reference" position="after">
                <field
          name="invoice_user_id"
          string="Reviewer"
          invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
          readonly="state != 'draft'"
          widget="many2one_avatar_user"
        />
            </field>
        </field>
    </record>
</odoo>
