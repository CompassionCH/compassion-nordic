<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="notification_settings" model="ir.ui.view">
        <field name="name">staff.notification.settings.form</field>
        <field name="model">res.config.settings</field>
        <field
      name="inherit_id"
      ref="message_center_compassion.compassion_settings"
    />
        <field name="arch" type="xml">
            <xpath
        expr="//app[@name='compassion_settings']//block[@name='notification_configuration']"
        position="inside"
      >
                <setting string="Mandate Notification">
                    <field name="mandate_notif_id" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
