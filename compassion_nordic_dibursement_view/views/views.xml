<odoo>
    <data>
        <record model="ir.ui.view" id="disbursement_data_tree_view">
            <field name="name">Disbursement Data List View</field>
            <field name="model">disbursement.data</field>
            <field name="arch" type="xml">
                <list>
                    <field name="company_id" />
                    <field name="month" />
                    <field name="account_id" />
                    <field name="product_id" />
                    <field name="debit" />
                    <field name="credit" />
                    <field name="amount" />
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="disbursement_data_action">
            <field name="name">Disbursement Data</field>
            <field name="res_model">disbursement.data</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem
      name="Disbursement Data"
      id="menu_disbursement_data"
      action="disbursement_data_action"
      parent="account.menu_finance_entries"
      sequence="20"
    />
    </data>
</odoo>
