<odoo noupdate="1">
    <record model="mail.template" id="mail_thankyou_birthday_autogift">
        <field name="name">Thank you for the birthday gift</field>
        <field name="model_id" ref="model_partner_communication_job" />
    </record>
    <record model="mail.template" id="mail_birthday_reminder">
        <field name="name">Birthday reminder</field>
        <field name="model_id" ref="model_partner_communication_job" />
    </record>
    <record
    model="partner.communication.config"
    id="config_thankyou_birthday_gift"
  >
        <field name="name">Birthday gift thank you</field>
        <field name="email_template_id" ref="mail_thankyou_birthday_autogift" />
        <field
      name="model_id"
      ref="sponsorship_compassion.model_account_move_line"
    />
        <field name="send_mode">digital</field>
    </record>
    <record model="partner.communication.config" id="config_birthday_reminder">
        <field name="name">Birthday reminder</field>
        <field name="email_template_id" ref="mail_birthday_reminder" />
        <field
      name="model_id"
      ref="sponsorship_compassion.model_recurring_contract"
    />
        <field name="send_mode">digital</field>
    </record>

    <record model="ir.actions.server" id="send_birthday_thankyou">
        <field name="name">Send birthday thank you communication</field>
        <field
      name="model_id"
      ref="sponsorship_compassion.model_account_move_line"
    />
        <field name="state">communication</field>
        <field name="config_id" ref="config_thankyou_birthday_gift" />
        <field name="partner_field">partner_id</field>
    </record>
    <record model="base.automation" id="automation_birthday_thankyou">
        <field name="name">Send birthday thank you communication SE</field>
        <field
      name="model_id"
      ref="sponsorship_compassion.model_account_move_line"
    />
        <field name="trigger">on_time</field>
        <field
      name="trg_date_id"
      ref="account.field_account_move_line__invoice_date"
    />
        <field name="trg_date_range_type">day</field>
        <field name="trg_date_range">-20</field>
        <field
      name="filter_domain"
    >[('product_id.categ_id', '=', ref('sponsorship_compassion.gift_type_birthday').id), ('parent_state', '=', 'posted'), ('move_id.payment_mode_id', '=', 'Autogiro'),('invoice_date', '>=', '2026-03-01')]</field>
        <field
      name="action_server_ids"
      eval="[(4, ref('partner_communication_nordic.send_birthday_thankyou'))]"
    />
    </record>

    <record model="ir.cron" id="cron_birthday_reminder">
        <field name="name">Send birthday reminder communication</field>
        <field name="model_id" ref="model_recurring_contract" />
        <field name="state">code</field>
        <field name="code">model.cron_generate_birthday_reminders()</field>
        <field name="interval_type">months</field>
        <field name="interval_number">1</field>
    </record>
</odoo>
