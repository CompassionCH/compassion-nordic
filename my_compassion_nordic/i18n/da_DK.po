msgstr "Velkommen! Opret din MyCompassion-konto"

#. module: my_compassion_nordic
#: model:ir.model.fields,field_description:my_compassion_nordic.field_payment_provider__adyen_auto_rescue_enabled
msgid "Auto Rescue"
msgstr "Auto Rescue"

#. module: my_compassion_nordic
#: model:ir.model.fields,help:my_compassion_nordic.field_payment_transaction__my2_rescue_reference
msgid "Adyen Auto Rescue identifier of a refused charge the provider retries on its own schedule."
msgstr "Adyen Auto Rescue-identifikator for en afvist debitering, som udbyderen forsøger igen efter sin egen plan."

#. module: my_compassion_nordic
#: model:mail.template,name:my_compassion_nordic.mail_digital_payment_fixit_final
