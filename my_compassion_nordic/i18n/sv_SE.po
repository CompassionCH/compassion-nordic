#. module: my_compassion_nordic
#: model:mail.template,body_html:my_compassion_nordic.mail_digital_payment_fixit_final
msgid ""
"<div>\n"
"          <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"          <t t-set=\"group\" t-value=\"object.get_objects()[:1].group_id\"/>\n"
"        </div>\n"
"        <p>\n"
"          <t t-out=\"partner.salutation\"/>\n"
"        </p>\n"
"        <p>\n"
"    Two weeks ago we let you know that your monthly sponsorship payment could not be collected. The payment is still outstanding.\n"
"</p>\n"
"        <p>\n"
"    Please update your card using the secure link below - it only takes a minute, the outstanding amount is collected right away and your sponsorship continues without interruption.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"group._my2_update_card_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Update my card\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    If we do not hear from you, one of our team members will contact you personally.\n"
"</p>\n"
"        <p>\n"
"    Thank you for standing with your sponsored child!\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "
msgstr ""
"<div>\n"
"          <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"          <t t-set=\"group\" t-value=\"object.get_objects()[:1].group_id\"/>\n"
"        </div>\n"
"        <p>\n"
"          <t t-out=\"partner.salutation\"/>\n"
"        </p>\n"
"        <p>\n"
"    För två veckor sedan meddelade vi dig att din månatliga fadderskapsbetalning inte kunde dras. Betalningen är fortfarande obetald.\n"
"</p>\n"
"        <p>\n"
"    Uppdatera ditt kort via den säkra länken nedan - det tar bara en minut, det utestående beloppet dras direkt och ditt fadderskap fortsätter utan avbrott.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"group._my2_update_card_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Uppdatera mitt kort\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    Om vi inte hör från dig kommer en av våra medarbetare att kontakta dig personligen.\n"
"</p>\n"
"        <p>\n"
"    Tack för att du står vid ditt fadderbarns sida!\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "

#. module: my_compassion_nordic
#: model:mail.template,body_html:my_compassion_nordic.mail_digital_payment_fixit_first
msgid ""
"<div>\n"
"          <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"          <t t-set=\"group\" t-value=\"object.get_objects()[:1].group_id\"/>\n"
"        </div>\n"
"        <p>\n"
"          <t t-out=\"partner.salutation\"/>\n"
"        </p>\n"
"        <p>\n"
"    We could not collect your monthly sponsorship payment: your card was declined. It may have expired or been replaced.\n"
"</p>\n"
"        <p>\n"
"    You can update your card in a minute using the secure link below. Any outstanding amount will be collected right away and your sponsorship will continue without interruption.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"group._my2_update_card_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Update my card\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    If you have already updated your card, you can safely ignore this email.\n"
"</p>\n"
"        <p>\n"
"    Thank you for your faithful support!\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "
msgstr ""
"<div>\n"
"          <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"          <t t-set=\"group\" t-value=\"object.get_objects()[:1].group_id\"/>\n"
"        </div>\n"
"        <p>\n"
"          <t t-out=\"partner.salutation\"/>\n"
"        </p>\n"
"        <p>\n"
"    Vi kunde inte dra din månatliga fadderskapsbetalning: ditt kort nekades. Det kan ha gått ut eller ha ersatts.\n"
"</p>\n"
"        <p>\n"
"    Du kan uppdatera ditt kort på en minut via den säkra länken nedan. Eventuellt utestående belopp dras direkt och ditt fadderskap fortsätter utan avbrott.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"group._my2_update_card_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Uppdatera mitt kort\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    Om du redan har uppdaterat ditt kort kan du bortse från det här mejlet.\n"
"</p>\n"
"        <p>\n"
"    Tack för ditt trogna stöd!\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "

#. module: my_compassion_nordic
#: model:mail.template,body_html:my_compassion_nordic.mail_portal_invitation
msgid ""
"<div>\n"
"          <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"        </div>\n"
"        <p>\n"
"          <t t-out=\"partner.salutation\"/>\n"
"        </p>\n"
"        <p>\n"
"    Thank you for becoming a sponsor! Your sponsorship is now confirmed.\n"
"</p>\n"
"        <p>\n"
"    Create your personal MyCompassion account to write to your sponsored child, follow their story and manage your sponsorship online.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"partner._get_signup_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Create my account\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    If you did not expect this, you can safely ignore this email.\n"
"</p>\n"
"        <p>\n"
"    Best regards\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "
msgstr ""
"<div>\n"
"          <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"        </div>\n"
"        <p>\n"
"          <t t-out=\"partner.salutation\"/>\n"
"        </p>\n"
"        <p>\n"
"    Tack för att du har blivit fadder! Ditt fadderskap är nu bekräftat.\n"
"</p>\n"
"        <p>\n"
"    Skapa ditt personliga MyCompassion-konto för att skriva till ditt fadderbarn, följa barnets berättelse och hantera ditt fadderskap online.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"partner._get_signup_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Skapa mitt konto\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    Om du inte väntade dig det här mejlet kan du bortse från det.\n"
"</p>\n"
"        <p>\n"
"    Med vänliga hälsningar\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "

