msgid "Reminder: your sponsorship payment is still outstanding"
msgstr "Muistutus: kummiusmaksusi on edelleen maksamatta"

#. module: my_compassion_nordic
#: model:mail.template,subject:my_compassion_nordic.mail_digital_payment_fixit_first
msgid "We could not process your sponsorship payment"
msgstr "Emme voineet käsitellä kummiusmaksuasi"

#. module: my_compassion_nordic
#: model:mail.template,subject:my_compassion_nordic.mail_portal_invitation
msgid "Welcome! Create your MyCompassion account"
msgstr "Tervetuloa! Luo MyCompassion-tilisi"
