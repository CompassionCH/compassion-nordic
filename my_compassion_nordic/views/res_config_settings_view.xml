<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- Where MyCompassion's "sponsor a child" links lead, per website -->
  <record id="res_config_settings_view_form_my2_sponsor_child_url" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.my2.sponsor.child.url</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <block id="website_info_settings" position="inside">
        <setting
          id="my2_sponsor_child_url_setting"
          string="Sponsor a child link"
          help="Page of the public website where MyCompassion sends a sponsor who wants to sponsor another child. When empty, the sponsor stays in MyCompassion, on its list of children waiting for a sponsor."
        >
          <field name="sponsor_child_url" widget="url" />
        </setting>
      </block>
    </field>
  </record>
</odoo>
