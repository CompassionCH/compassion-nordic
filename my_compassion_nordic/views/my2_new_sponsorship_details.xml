<?xml version="1.0" encoding="utf-8" ?>
<!--
Nordic version of the post-payment sponsor details form.

    A required step of the signup (recurring.contract._my2_details_mandatory):
    no "do this later", and no optional address. Its name fields are prefilled
    from what Stripe reported and stay editable, because the name typed here
    is the letter writer's, who may not be the payer (see
    recurring.contract._my2_apply_details).

    It has no heading of its own: the page title above it thanks the
    sponsor, and the form opens on a line saying what the details are for.

    Between the name and the phone number it asks the payer's national
    identity number, so the gift can be reported to their tax authority and
    they get their deduction:

    - Sweden: personnummer, for Skatteverket's KU65.
    - Norway: fodselsnummer or D-nummer, for Skatteetaten's gaver til
      frivillige organisasjoner.
    - Denmark: CPR-nummer, for skatteindberetningsloven § 26.

    Optional, and stated as such. The reporting duty is what makes collecting
    a national identity number lawful in each of the three countries, and it
    is purpose-bound: a sponsor who does not want the deduction leaves the
    field empty and nothing stops them.

    Injected data (added to the base form's, see my_compassion):
    - details_prefill['social_sec_nr']: what the sponsor typed, when the form
      came back with an error. Never a number already on file.
    - sponsorship ('recurring.contract'): whose company decides both whether
      the field renders at all and which country's number it takes.
-->
<odoo>
  <!-- While the form shows, the title of the thank-you page says the
       sponsorship has begun, and the form below asks for the details. -->
  <template
    id="my2_new_sponsorship_thank_you_title_nordic"
    inherit_id="my_compassion.my2_new_sponsorship_thank_you_title"
    name="New Sponsorship Thank You Title - Nordic"
    priority="99"
  >
    <xpath expr="//h1" position="replace">
      <h1
        t-if="details_token and sponsorship._my2_details_mandatory()"
        class="title-heading title-size-md text-dark-blue"
      >
        Thank you for becoming the sponsor of <span class="text-core-blue">
          <t t-out="sponsorship.child_id.preferred_name" />
        </span>
      </h1>
      <t t-else="">$0</t>
    </xpath>
  </template>
  <!-- While the form shows, the card of the child above it gives no reason
       for the form: the form's own intro says what the details are for.
       The card keeps its title and photo. -->
  <template
    id="my2_new_sponsorship_thank_you_letter_card_nordic"
    inherit_id="my_compassion.my2_new_sponsorship_thank_you_page"
    name="New Sponsorship Thank You Letter Card - Nordic"
    priority="99"
  >
    <xpath
      expr="//t[@t-set='top_class'][@t-value=&quot;'ns-letter-card'&quot;]/../t[@t-set='subtext'][last()]"
      position="after"
    >
      <t t-if="sponsorship._my2_details_mandatory()" t-set="subtext" t-value="False" />
    </xpath>
  </template>
  <template
    id="my2_new_sponsorship_details_form_nordic"
    inherit_id="my_compassion.my2_new_sponsorship_details_form"
    name="New Sponsorship Details - Nordic Form"
    priority="99"
  >
    <!-- The page title above the form already thanks the sponsor (see
         my2_new_sponsorship_thank_you_title_nordic), so the form opens on
         what it is for: its own heading (div.h4) goes, and its intro (the
         element after the heading) is replaced. The intro is replaced
         first, while the heading still marks it.
         All of it applies while the form is a required step
         (recurring.contract._my2_details_mandatory), which this module
         makes the case; otherwise the base form renders unchanged. -->
    <xpath expr="//div[hasclass('h4')]/following-sibling::div[1]" position="replace">
      <t t-if="not sponsorship._my2_details_mandatory()">$0</t>
      <t t-else="">
        <div class="mb-1 text-center text-lg-start tiny-text text-mid-grey">
          Please fill in your details so we can manage your new sponsorship.
        </div>
        <div class="mb-3 text-center text-lg-start tiny-text text-mid-grey">
          If someone else will write the letters, enter their name instead.
        </div>
      </t>
    </xpath>
    <xpath expr="//div[hasclass('h4')]" position="replace">
      <t t-if="not sponsorship._my2_details_mandatory()">$0</t>
    </xpath>
    <xpath expr="//details" position="replace">
      <t t-if="not sponsorship._my2_details_mandatory()">$0</t>
    </xpath>
  </template>
  <template
    id="my2_new_sponsorship_details_ssn"
    inherit_id="my_compassion.my2_new_sponsorship_details_extra_fields"
    name="New Sponsorship Details - National Identity Number"
  >
    <xpath expr="." position="inside">
      <t t-if="sponsorship._my2_collects_ssn()">
        <t t-set="ssn_country" t-value="sponsorship._my2_ssn_country_code()" />
        <t t-call="theme_compassion_2025.FormFieldComponent">
          <t t-set="top_class" t-value="'my-3'" />
          <t t-set="label">
            <t
              t-if="ssn_country == 'SE'"
            >Personnummer (for gift reporting to Skatteverket)</t>
            <t
              t-elif="ssn_country == 'NO'"
            >Fødselsnummer (for gift reporting to Skatteetaten)</t>
            <t t-else="">CPR-nummer (for gift reporting to Skattestyrelsen)</t>
          </t>
          <t t-set="input_id" t-value="'details_social_sec_nr'" />
          <input
            id="details_social_sec_nr"
            type="text"
            name="social_sec_nr"
            class="form-control"
            autocomplete="off"
            t-att-value="details_prefill.get('social_sec_nr')"
          />
          <div class="body-small text-low-black mt-1">
            <t
              t-if="ssn_country == 'SE'"
            >Optional, and always the payer's own number, even when someone else writes the letters. We only use it to report your gift to Skatteverket, so you get your tax deduction. Once we have it, the report is made automatically and cannot be declined.</t>
            <t
              t-elif="ssn_country == 'NO'"
            >Optional, and always the payer's own number, even when someone else writes the letters. We only use it to report your gift to Skatteetaten, so you get your tax deduction.</t>
            <t
              t-else=""
            >Optional, and always the payer's own number, even when someone else writes the letters. We only use it to report your gift to Skattestyrelsen, so you get your tax deduction. Tell us before the end of the year if you would rather we did not report it.</t>
          </div>
        </t>
      </t>
    </xpath>
  </template>
</odoo>
