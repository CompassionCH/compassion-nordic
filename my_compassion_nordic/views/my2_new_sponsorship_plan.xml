<?xml version="1.0" encoding="utf-8" ?>
<!--
Nordic plan choice of the new-sponsorship checkout.

    In place of the optional "Sponsorship plus" checkbox, two required radio
    buttons, neither checked until the sponsor picks one: the sponsorship
    alone, or with the Plus contribution (product fund_gen), each named
    after its product and priced by the website's pricelist. The link below
    them opens the explanation of the Plus.

    Both radios post "sponsorship_plus": "0" for the sponsorship alone, "1"
    for the Plus (see new.sponsorship.wizard.update in this module).

    Everything here applies while new.sponsorship.wizard._my2_plan_required
    is on, which this module makes the case; otherwise the base checkbox and
    its explanation render unchanged.

    The same switch makes the checkout's total wait for a plan and the
    summary after the checkout name the Plus plan as its radio does.

    Injected data (from the base step rendering):
    - wizard ('new.sponsorship.wizard'): sponsorship_plan checks the radio
      already picked, and _my2_plan_choice supplies the copy.
    - website: whose products, pricelist and currency the copy shows.
-->
<odoo>
  <template
    id="my2_new_sponsorship_wizard_sponsorship_plus_nordic"
    inherit_id="my_compassion.my2_new_sponsorship_wizard_sponsorship_plus"
    name="New Sponsorship Wizard Sponsorship Plus - Nordic Plan Choice"
    priority="99"
  >
    <xpath
      expr="//div[@id='sponsorship-plus-info-modal']/preceding-sibling::div[1]"
      position="replace"
    >
      <t
        t-set="plan_choice"
        t-value="wizard._my2_plan_required() and wizard._my2_plan_choice(website)"
      />
      <t t-if="not plan_choice">$0</t>
      <fieldset t-else="" class="my-3">
        <legend class="visually-hidden">Choose your sponsorship</legend>
        <t t-foreach="plan_choice['options']" t-as="plan">
          <label
            t-att-for="plan['input_id']"
            t-attf-class="d-flex align-items-center p-3 rounded rounded-lg bg-light-blue border border-mid-grey #{'mt-2' if plan_index else ''}"
          >
            <input
              type="radio"
              t-att-id="plan['input_id']"
              name="sponsorship_plus"
              t-att-value="plan['value']"
              class="form-check-input mt-0 me-3 flex-shrink-0"
              t-att-checked="plan['checked']"
              required=""
            />
            <span class="very-tiny-text">
              <span class="text-dark-blue bold" t-out="plan['name']" />
              <span class="text-core-blue" t-out="plan['price']" />
            </span>
          </label>
        </t>
        <!-- Shown by the wizard's form validation while no plan is checked
             (sponsorship_plan_choice.esm.js), which points the radios'
             aria-describedby at it while it shows. -->
        <div
          id="ns-plan-error"
          class="ns-plan-error d-none mt-2 tiny-text text-mid-orange"
          role="alert"
        >Please choose one of the two sponsorship options before continuing.</div>
        <a
          href="#"
          class="d-inline-block mt-2 very-tiny-text bold text-core-blue"
          data-bs-toggle="modal"
          data-bs-target="#sponsorship-plus-info-modal"
          t-out="plan_choice['question']"
        />
      </fieldset>
    </xpath>
    <xpath expr="//div[@id='sponsorship-plus-info-modal-title']" position="attributes">
      <!-- Without a plan choice, t-out falls back to the base title. -->
      <attribute name="t-out">plan_choice and plan_choice['question']</attribute>
    </xpath>
    <xpath
      expr="//div[@id='sponsorship-plus-info-modal-title']/following-sibling::div[1]"
      position="replace"
    >
      <t t-if="not plan_choice">$0</t>
      <div t-else="" class="body-small">
        <p t-out="plan_choice['contribution']" />
        <p>This money can be used for all of Compassion's programmes, wherever it is needed most.</p>
        <p
          class="mb-0"
        >It can be, for example, clean water, sanitation facilities, disaster relief, health programmes for mothers and babies, or registered children who have not yet found a sponsor.</p>
      </div>
    </xpath>
  </template>
  <!-- The total of the checkout shows no amount until a plan is chosen;
       the script then keeps it in line with the radio. -->
  <template
    id="my2_new_sponsorship_wizard_fast_checkout_nordic"
    inherit_id="my_compassion.my2_new_sponsorship_wizard_fast_checkout"
    name="New Sponsorship Wizard Fast Checkout - Nordic Total"
    priority="99"
  >
    <xpath expr="//span[@id='ns-total-amount']" position="attributes">
      <attribute
        name="t-out"
      >'–' if wizard._my2_plan_required() and not wizard.sponsorship_plan else currency_name + '&#160;' + ns_total_formatted</attribute>
    </xpath>
  </template>
  <!-- The summary after the checkout names the Plus plan as its radio did. -->
  <template
    id="my2_new_sponsorship_all_set_nordic"
    inherit_id="my_compassion.my2_new_sponsorship_all_set"
    name="New Sponsorship All Set - Nordic Plan Name"
    priority="99"
  >
    <xpath expr="//div[@t-if='sponsorship_plus_line']/span[1]" position="replace">
      <t t-set="plan_wizard" t-value="request.env['new.sponsorship.wizard']" />
      <t t-if="not plan_wizard._my2_plan_required()">$0</t>
      <span
        t-else=""
        class="tiny-text text-mid-grey"
        t-out="plan_wizard._my2_plus_plan_name(website)"
      />
    </xpath>
  </template>
</odoo>
