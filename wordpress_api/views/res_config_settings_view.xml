<odoo>
     <!-- Configuration View -->
    <record id="view_settings" model="ir.ui.view">
        <field name="name">wordpress_api.settings</field>
        <field name="model">res.config.settings</field>
        <field
      name="inherit_id"
      ref="message_center_compassion.compassion_settings"
    />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='compassion_settings']" position="inside">
                <block
          title="External APIs"
          name="compassion_settings_external_apis"
        >
                    <setting
            string="Wordpress API Key"
            help="Enter your Wordpress API key here."
          >
                        <field name="wordpress_api_key" />
                    </setting>
                    <setting
            string="Giving Platform API Key"
            help="Enter your Giving Platform API key here."
          >
                        <field name="giving_platform_api_key" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
